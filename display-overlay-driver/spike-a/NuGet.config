<?xml version="1.0" encoding="utf-8"?>
<!-- Restore the WDK + SDK.cpp packages from the local ./feed folder rather than
     nuget.org. The box's link to nuget.org is flaky; a local feed makes restore
     deterministic and offline.

     ./feed is git-IGNORED (it is 304MB of nupkgs and would break `git push`). Recreate it
     before the first build with the exact pinned versions listed in ../README.md
     ("Offline NuGet feed"), e.g.:
       nuget install -OutputDirectory feed -Version 10.0.26100.6584 Microsoft.Windows.WDK.x64
       nuget install -OutputDirectory feed -Version 10.0.26100.1 Microsoft.Windows.SDK.cpp
       nuget install -OutputDirectory feed -Version 10.0.26100.1 Microsoft.Windows.SDK.cpp.x64
     (or copy the three nupkgs from a box that already has them). -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-wdk" value="feed" />
  </packageSources>
</configuration>