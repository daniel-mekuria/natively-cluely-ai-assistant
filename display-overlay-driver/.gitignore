# Build artifacts (regenerated by spike-a/build.ps1)
spike-a/bin/
spike-a/obj/
spike-a/client/client.exe
*.obj
*.pdb

# Keep the Phase A proof-of-pipeline log: it is the evidence the driver reaches
# STATE: 4 RUNNING and the client round-trips IOCTL_NOV_ECHO (0x1234 -> 0x1235).
# The root .gitignore has a blanket *.log rule; this re-includes just this file.
!spike-a/load-postreboot.log

# The offline NuGet feed (pinned WDK/SDK.cpp nupkgs) is git-IGNORED, not committed: it is
# 304MB of binary packages and blows past the git push size limit (HTTP 408 on the 304MB
# pack). It is a build INPUT, not source. recreate it into spike-a/feed/ before building —
# the exact pinned versions + `nuget install` commands are in ../README.md ("Offline
# NuGet feed"). Everything else here (source, scripts, wdk-toolset/, README) is tracked.
spike-a/feed/